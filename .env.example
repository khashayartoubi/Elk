# Elastic Stack version
STACK_VERSION=9.2.0

# Kibana web interface
KIBANA_BIND_IP=127.0.0.1
KIBANA_PORT=5601

# Heap size for the Elasticsearch JVM
ES_HEAP=1g

# Canonical ECS log fields. A service can override the type with the Docker
# label: elk_service_type: "...".
# Set this to the LAN IP of the Docker host on every deployment server.
LOG_HOST_IP=192.168.10.154
LOG_SERVICE_TYPE=nodejs

# Number of days to retain Elasticsearch indices and local NDJSON archives.
LOG_RETENTION_DAYS=7

# Elastic's built-in administrator account; do not use the browser account
# below for service-to-service authentication.
ELASTIC_PASSWORD=replace-with-a-strong-elastic-password
# Internal account used only by Kibana to connect to Elasticsearch.
KIBANA_SYSTEM_PASSWORD=replace-with-a-strong-kibana-system-password
# Browser login account created by the setup container.
KIBANA_LOGIN_USER=replace-with-an-admin-username
KIBANA_LOGIN_PASSWORD=replace-with-a-strong-browser-password

